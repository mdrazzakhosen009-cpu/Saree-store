<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Manage Products</title><script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans flex min-h-screen">
<aside class="w-64 bg-gray-900 text-white min-h-screen p-6 flex flex-col justify-between shrink-0">
<div><h2 class="text-xl font-bold mb-8 tracking-wider">SAREE ADMIN</h2><nav class="space-y-3 font-medium">
<a href="/admin/dashboard" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-home mr-3"></i> Dashboard</a>
<a href="/admin/products" class="block py-2.5 px-4 rounded-lg bg-rose-900 text-white"><i class="fa fa-box mr-3"></i> Products</a>
<a href="/admin/orders" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-shopping-cart mr-3"></i> Orders</a>
<a href="/admin/settings" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-cogs mr-3"></i> Settings & Logo</a>
<a href="/admin/password" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-key mr-3"></i> Change Password</a></nav></div>
<div><a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a></div>
</aside>
<main class="flex-1 p-8 overflow-y-auto">
<h1 class="text-3xl font-bold mb-8">Manage Products</h1>
<div class="bg-white p-6 rounded-2xl shadow-sm border mb-8">
<h3 class="text-lg font-bold mb-4">Add New Saree</h3>
<form action="/admin/products/add" method="POST" enctype="multipart/form-data" class="grid grid-cols-1 md:grid-cols-3 gap-4">
<div><label class="block text-sm font-bold mb-1">Product Name</label><input type="text" name="name" required class="w-full border rounded-lg px-3 py-2 text-sm"></div>
<div><label class="block text-sm font-bold mb-1">Category</label><input type="text" name="category" placeholder="e.g. Jamdani, Katan" required class="w-full border rounded-lg px-3 py-2 text-sm"></div>
<div><label class="block text-sm font-bold mb-1">Price (BDT)</label><input type="number" name="price" min="0" step="0.01" required class="w-full border rounded-lg px-3 py-2 text-sm"></div>
<div><label class="block text-sm font-bold mb-1">Old Price</label><input type="number" name="old_price" min="0" step="0.01" class="w-full border rounded-lg px-3 py-2 text-sm"></div>
<div><label class="block text-sm font-bold mb-1">Product Image</label><input type="file" name="image" accept="image/*" required class="w-full border rounded-lg px-3 py-2 text-sm"></div>
<div class="flex items-center space-x-2 pt-6"><input type="checkbox" name="is_featured" value="1" id="feat"><label for="feat" class="text-sm font-bold">Featured Product</label></div>
<div class="col-span-full"><label class="block text-sm font-bold mb-1">Description</label><textarea name="description" rows="2" class="w-full border rounded-lg px-3 py-2 text-sm"></textarea></div>
<button type="submit" class="bg-rose-900 text-white px-6 py-2 rounded-lg font-bold shadow">Add Product</button>
</form></div>
<div class="bg-white p-6 rounded-2xl shadow-sm border">
<h3 class="text-lg font-bold mb-4">All Products</h3>
<div class="overflow-x-auto"><table class="w-full text-left border-collapse text-sm"><thead><tr class="border-b bg-gray-50"><th class="p-3">Image</th><th class="p-3">Name</th><th class="p-3">Category</th><th class="p-3">Price</th><th class="p-3">Action</th></tr></thead><tbody>
<% products.forEach(p => { %><tr class="border-b"><td class="p-3"><img src="<%= p.image || '/uploads/default-saree.svg' %>" class="w-12 h-12 object-cover rounded-lg"></td><td class="p-3 font-bold"><%= p.name %></td><td class="p-3"><%= p.category %></td><td class="p-3">৳<%= Number(p.price).toFixed(2) %></td><td class="p-3"><div class="flex items-center gap-3">
<a href="/admin/products/edit/<%= p.id %>" class="text-blue-700 hover:underline" title="Edit"><i class="fa fa-pen"></i></a>
<form action="/admin/products/delete/<%= p.id %>" method="POST" onsubmit="return confirm('Delete product?')"><button type="submit" class="text-red-600 hover:underline" title="Delete"><i class="fa fa-trash"></i></button></form>
</div></td></tr><% }) %>
</tbody></table></div></div>
</main></body></html>
