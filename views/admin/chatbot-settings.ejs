<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Chatbot Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex min-h-screen">
    <aside class="w-64 bg-gray-900 text-white p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold mb-6">SARAE ADMIN</h2>
            <nav class="space-y-2 text-sm">
                <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-gray-800">Dashboard</a>
                <a href="/admin/ai-agent" class="block py-2 px-3 rounded-lg hover:bg-gray-800">🤖 AI Agent</a>
                <a href="/admin/payment-settings" class="block py-2 px-3 rounded-lg hover:bg-gray-800">💳 Payment Settings</a>
                <a href="/admin/logo-design" class="block py-2 px-3 rounded-lg hover:bg-gray-800">🎨 Store Logo & Design</a>
                <a href="/admin/chatbot-settings" class="block py-2 px-3 rounded-lg bg-gray-800 font-bold">💬 Chatbot Settings</a>
            </nav>
        </div>
        <a href="/admin/logout" class="text-red-400">Logout</a>
    </aside>
    <main class="flex-1 p-8 overflow-y-auto">
        <h1 class="text-3xl font-bold mb-6">Chatbot & Footer Settings</h1>
        <% if (message) { %><div class="bg-green-100 text-green-700 p-3 rounded-lg mb-4"><%= message %></div><% } %>
        <form action="/admin/chatbot-settings" method="POST" class="bg-white p-6 rounded-xl shadow-sm max-w-xl space-y-4">
            <div>
                <label class="block text-sm font-bold mb-1">Delivery Time Info (Chatbot & Footer)</label>
                <input type="text" name="delivery_time" value="<%= settings.delivery_time %>" class="w-full border p-2 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Store Info (What we sell)</label>
                <textarea name="store_info" rows="3" class="w-full border p-2 rounded-lg"><%= settings.store_info %></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Chatbot Order Instructions Prompt</label>
                <textarea name="chat_order_prompt" rows="3" class="w-full border p-2 rounded-lg"><%= settings.chat_order_prompt %></textarea>
            </div>
            <button type="submit" class="bg-rose-900 text-white px-6 py-2 rounded-lg font-bold">Save Chatbot Settings</button>
        </form>
    </main>
</body>
</html>
