<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Edit Product</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body class="bg-gray-100 font-sans min-h-screen flex"><aside class="w-64 bg-gray-900 text-white min-h-screen p-6 flex flex-col justify-between"><div><h2 class="text-xl font-bold mb-8 tracking-wider">SAREE ADMIN</h2><nav class="space-y-3 font-medium"><a href="/admin/dashboard" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-home mr-3"></i> Dashboard</a><a href="/admin/products" class="block py-2.5 px-4 rounded-lg bg-rose-900 text-white"><i class="fa fa-box mr-3"></i> Products</a><a href="/admin/orders" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-shopping-cart mr-3"></i> Orders</a><a href="/admin/settings" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-cogs mr-3"></i> Settings & Logo</a></nav></div><a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a></aside>
<main class="flex-1 p-8"><div class="max-w-3xl mx-auto"><div class="flex justify-between items-center mb-8"><h1 class="text-3xl font-bold">Edit Product</h1><a href="/admin/products" class="text-rose-900 font-bold">← Back</a></div><% if(error) { %><div class="bg-red-50 text-red-700 p-4 rounded-xl mb-6"><%= error %></div><% } %>
<form action="/admin/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-2xl shadow-sm border space-y-5"><div><label class="block text-sm font-bold mb-1">Product Name</label><input name="name" value="<%= product.name %>" required class="w-full border rounded-lg px-3 py-2"></div><div><label class="block text-sm font-bold mb-1">Category</label><input name="category" value="<%= product.category %>" required class="w-full border rounded-lg px-3 py-2"></div><div class="grid md:grid-cols-2 gap-4"><div><label class="block text-sm font-bold mb-1">Price</label><input type="number" min="0" step="0.01" name="price" value="<%= product.price %>" required class="w-full border rounded-lg px-3 py-2"></div><div><label class="block text-sm font-bold mb-1">Old Price</label><input type="number" min="0" step="0.01" name="old_price" value="<%= product.old_price %>" class="w-full border rounded-lg px-3 py-2"></div></div><div><label class="block text-sm font-bold mb-1">Replace Image (optional)</label><input type="file" name="image" accept="image/*" class="w-full border rounded-lg px-3 py-2"><img src="<%= product.image || '/uploads/default-saree.svg' %>" class="mt-3 w-24 h-24 object-cover rounded-xl border"></div><div><label class="block text-sm font-bold mb-1">Description</label><textarea name="description" rows="5" class="w-full border rounded-lg px-3 py-2"><%= product.description || '' %></textarea></div><label class="flex items-center gap-2"><input type="checkbox" name="is_featured" value="1" <%= product.is_featured ? 'checked' : '' %>><span class="font-bold text-sm">Featured Product</span></label><button class="bg-rose-900 text-white px-6 py-3 rounded-xl font-bold">Save Changes</button></form></div></main></body></html>
