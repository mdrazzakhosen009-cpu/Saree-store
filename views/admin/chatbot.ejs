<!-- AI Shopping Assistant Floating Widget -->
<div id="ai-chat-widget" class="fixed bottom-5 right-5 z-50">
    <button onclick="toggleChat()" class="bg-primary text-white p-4 rounded-full shadow-2xl hover:opacity-95 transition flex items-center justify-center">
        <i class="fa fa-robot text-xl"></i>
    </button>

    <div id="chat-box" class="hidden absolute bottom-16 right-0 w-80 md:w-96 bg-white rounded-2xl shadow-2xl border border-gray-200 overflow-hidden flex flex-col">
        <div class="bg-primary text-white p-4 flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <i class="fa fa-robot"></i>
                <span class="font-bold">AI Saree Assistant</span>
            </div>
            <button onclick="toggleChat()" class="text-white hover:text-gray-200"><i class="fa fa-times"></i></button>
        </div>

        <div id="chat-messages" class="p-4 h-72 overflow-y-auto space-y-3 text-sm bg-gray-50 flex flex-col">
            <div class="bg-white p-3 rounded-xl shadow-sm self-start max-w-[85%] border border-gray-100">
                Namaste! Welcome to <strong><%= typeof settings !== 'undefined' ? settings.store_name : 'Store' %></strong>. How can I help you select the perfect saree today?
            </div>
        </div>

        <div class="p-2 bg-white border-t border-gray-200 flex flex-wrap gap-1">
            <button onclick="sendQuickOption('delivery')" class="text-xs bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full">Delivery Info</button>
            <button onclick="sendQuickOption('info')" class="text-xs bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full">Store Details</button>
            <button onclick="sendQuickOption('order')" class="text-xs bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-full">Place Order</button>
        </div>

        <div class="p-3 bg-white border-t border-gray-200 flex items-center space-x-2">
            <input type="text" id="chat-input" placeholder="Type a message or upload image..." class="flex-1 border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary" onkeypress="handleKeyPress(event)">
            <label class="cursor-pointer text-gray-500 hover:text-primary p-2">
                <i class="fa fa-camera"></i>
                <input type="file" id="ai-image-upload" class="hidden" accept="image/*" onchange="handleAiImageUpload(event)">
            </label>
            <button onclick="sendUserMessage()" class="bg-primary text-white px-4 py-2 rounded-lg text-sm"><i class="fa fa-paper-plane"></i></button>
        </div>
    </div>
</div>

<script>
function toggleChat() {
    const box = document.getElementById('chat-box');
    box.classList.toggle('hidden');
}

function appendMsg(sender, text) {
    const container = document.getElementById('chat-messages');
    const div = document.createElement('div');
    div.className = sender === 'user' ? 'bg-primary text-white p-3 rounded-xl shadow-sm self-end max-w-[85%]' : 'bg-white p-3 rounded-xl shadow-sm self-start max-w-[85%] border border-gray-100';
    div.innerHTML = text;
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
}

function sendQuickOption(type) {
    if(type === 'delivery') {
        appendMsg('user', 'Tell me about delivery time.');
        setTimeout(() => appendMsg('bot', '<%= typeof settings !== 'undefined' ? settings.delivery_time : "Standard delivery within 3-5 days." %>'), 500);
    } else if(type === 'info') {
        appendMsg('user', 'What do you sell?');
        setTimeout(() => appendMsg('bot', '<%= typeof settings !== 'undefined' ? settings.store_info : "We sell exclusive sarees." %>'), 500);
    } else if(type === 'order') {
        appendMsg('user', 'How to order now?');
        setTimeout(() => appendMsg('bot', '<%= typeof settings !== 'undefined' ? settings.chat_order_prompt : "Select a product and place your order easily." %>'), 500);
    }
}

function handleKeyPress(event) {
    if (event.key === 'Enter') {
        sendUserMessage();
    }
}

function sendUserMessage() {
    const input = document.getElementById('chat-input');
    if(!input.value.trim()) return;
    const txt = input.value;
    appendMsg('user', txt);
    input.value = '';
    setTimeout(() => {
        appendMsg('bot', 'Thank you for your message! Our agent or AI assistant will assist you momentarily, or you can check our catalog to place an order directly.');
    }, 600);
}

function handleAiImageUpload(event) {
    const file = event.target.files[0];
    if(!file) return;
    appendMsg('user', `<i class="fa fa-image"></i> Uploaded image for AI matching...`);
    const formData = new FormData();
    formData.append('customer_image', file);

    fetch('/api/ai/match', { method: 'POST', body: formData })
    .then(res => res.json())
    .then(data => {
        let html = 'AI Match found! Check out these similar sarees:<br>';
        if(data && data.matched_products) {
            data.matched_products.forEach(p => {
                html += `<div class="mt-2 flex items-center space-x-2"><img src="${p.image}" class="w-10 h-10 object-cover rounded"><span>${p.name} - ৳${p.price}</span></div>`;
            });
        } else {
            html += 'No matching products found right now.';
        }
        appendMsg('bot', html);
    }).catch(err => {
        appendMsg('bot', 'Could not match image at this moment. Please browse our catalog.');
    });
}
</script>
