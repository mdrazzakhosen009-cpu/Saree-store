<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Assistant - Admin Panel</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        body { display: flex; background: #f4f6f9; color: #333; min-height: 100vh; }
        .sidebar { width: 260px; background: #111827; color: #fff; display: flex; flex-direction: column; justify-content: space-between; padding: 20px 0; }
        .sidebar-top h2 { font-size: 20px; padding: 0 20px 20px 20px; border-bottom: 1px solid #1f2937; letter-spacing: 1px; }
        .sidebar-menu { list-style: none; margin-top: 20px; }
        .sidebar-menu li a { display: flex; align-items: center; gap: 12px; padding: 12px 20px; color: #9ca3af; text-decoration: none; font-size: 15px; transition: 0.3s; }
        .sidebar-menu li a:hover, .sidebar-menu li a.active { background: #1f2937; color: #fff; border-left: 4px solid #800020; }
        .main-content { flex: 1; padding: 30px; overflow-y: auto; }
        h1 { font-size: 24px; margin-bottom: 20px; color: #111827; }
        .card { background: #fff; padding: 25px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); max-width: 800px; }
        .form-group { margin-bottom: 20px; }
        label { display: block; margin-bottom: 8px; font-weight: 600; font-size: 14px; }
        textarea { width: 100%; padding: 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; resize: vertical; min-height: 120px; }
        button { background: #800020; color: #fff; border: none; padding: 12px 25px; border-radius: 6px; font-size: 15px; cursor: pointer; font-weight: 600; }
        button:hover { opacity: 0.9; }
        .alert { padding: 15px; background: #d1fae5; color: #065f46; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="sidebar-top">
            <h2>SARAE ADMIN</h2>
            <ul class="sidebar-menu">
                <li><a href="/admin/dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                <li><a href="/admin/products"><i class="fas fa-box"></i> Products</a></li>
                <li><a href="/admin/orders"><i class="fas fa-shopping-cart"></i> Orders</a></li>
                <li><a href="/admin/ai-assistant" class="active"><i class="fas fa-robot"></i> AI Assistant</a></li>
                <li><a href="/admin/settings"><i class="fas fa-cog"></i> Settings & Logo</a></li>
                <li><a href="/admin/password"><i class="fas fa-key"></i> Change Password</a></li>
            </ul>
        </div>
        <div style="padding: 0 20px;">
            <a href="/admin/logout" style="color: #f87171; text-decoration: none; display: flex; align-items: center; gap: 10px;"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1>AI Store Designer & Assistant</h1>
        <div class="card">
            <% if (responseMessage) { %>
                <div class="alert"><%= responseMessage %> <br><strong><%= generatedDesign %></strong></div>
            <% } %>
            <form action="/admin/ai-assistant" method="POST">
                <div class="form-group">
                    <label>Give instructions to AI Designer (e.g., Make theme dark, royal red, or gold):</label>
                    <textarea name="prompt_instruction" placeholder="Write your prompt here..."></textarea>
                </div>
                <button type="submit"><i class="fas fa-wand-magic-sparkles"></i> Generate & Apply</button>
            </form>
        </div>
    </div>
</body>
</html>
