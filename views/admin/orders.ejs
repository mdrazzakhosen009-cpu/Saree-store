<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Manage Orders</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body class="bg-gray-100 font-sans flex min-h-screen"><aside class="w-64 bg-gray-900 text-white min-h-screen p-6 flex flex-col justify-between shrink-0"><div><h2 class="text-xl font-bold mb-8 tracking-wider">SAREE ADMIN</h2><nav class="space-y-3 font-medium"><a href="/admin/dashboard" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-home mr-3"></i> Dashboard</a><a href="/admin/products" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-box mr-3"></i> Products</a><a href="/admin/orders" class="block py-2.5 px-4 rounded-lg bg-rose-900 text-white"><i class="fa fa-shopping-cart mr-3"></i> Orders</a><a href="/admin/settings" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-cogs mr-3"></i> Settings & Logo</a></nav></div><a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a></aside>
<main class="flex-1 p-8 overflow-y-auto"><h1 class="text-3xl font-bold mb-8">Manage Orders</h1><div class="bg-white p-6 rounded-2xl shadow-sm border"><div class="overflow-x-auto"><table class="w-full text-left border-collapse text-sm"><thead><tr class="border-b bg-gray-50"><th class="p-3">Order ID</th><th class="p-3">Customer</th><th class="p-3">Phone & Address</th><th class="p-3">Total</th><th class="p-3">Payment & TrxID</th><th class="p-3">Status Action</th></tr></thead><tbody>
<% orders.forEach(o => { %><tr class="border-b"><td class="p-3 font-bold"><%= o.order_id %></td><td class="p-3"><%= o.customer_name %></td><td class="p-3"><%= o.phone %><br><span class="text-xs text-gray-500"><%= o.address %></span></td><td class="p-3">৳<%= Number(o.total).toFixed(2) %></td><td class="p-3"><%= o.payment_method %><br><span class="text-xs text-gray-500">Trx: <%= o.trx_id || '-' %></span></td><td class="p-3"><form action="/admin/orders/status/<%= o.id %>" method="POST" class="flex items-center space-x-2"><select name="status" class="border rounded px-2 py-1 text-xs"><% ['Pending','Processing','Completed','Cancelled'].forEach(s => { %><option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option><% }) %></select><button type="submit" class="bg-rose-900 text-white px-2 py-1 rounded text-xs">Update</button></form></td></tr><% }) %>
</tbody></table></div></div></main></body></html>
