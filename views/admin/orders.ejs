<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Orders</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100 font-sans flex">
    <aside class="w-64 bg-gray-900 text-white min-h-screen p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold mb-8 tracking-wider">SARAE ADMIN</h2>
            <nav class="space-y-2 font-medium text-sm">
    <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">Dashboard</a>
    <a href="/admin/products" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">Products</a>
    <a href="/admin/orders" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">Orders</a>
    <a href="/admin/ai-agent" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">🤖 AI Agent</a>
    <a href="/admin/payment-settings" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">💳 Payment Settings</a>
    <a href="/admin/logo-design" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">🎨 Store Logo & Design</a>
    <a href="/admin/chatbot-settings" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">💬 Chatbot Settings</a>
    <a href="/admin/password" class="block py-2 px-3 rounded-lg hover:bg-gray-800 text-gray-300">Change Password</a>
</nav>
        </div>
        <div>
            <a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a>
        </div>
    </aside>

    <main class="flex-1 p-8 overflow-y-auto">
        <h1 class="text-3xl font-bold mb-8">Manage Orders</h1>
        <div class="bg-white p-6 rounded-2xl shadow-sm border">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse text-sm">
                    <thead>
                        <tr class="border-b bg-gray-50">
                            <th class="p-3">Order ID</th>
                            <th class="p-3">Customer</th>
                            <th class="p-3">Phone & Address</th>
                            <th class="p-3">Total</th>
                            <th class="p-3">Payment & TrxID</th>
                            <th class="p-3">Status Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(o => { %>
                            <tr class="border-b">
                                <td class="p-3 font-bold"><%= o.order_id %></td>
                                <td class="p-3"><%= o.customer_name %></td>
                                <td class="p-3"><%= o.phone %><br><span class="text-xs text-gray-500"><%= o.address %></span></td>
                                <td class="p-3">৳<%= o.total %></td>
                                <td class="p-3"><%= o.payment_method %><br><span class="text-xs text-gray-500">Trx: <%= o.trx_id %></span></td>
                                <td class="p-3">
                                    <form action="/admin/orders/status/<%= o.id %>" method="POST" class="flex items-center space-x-2">
                                        <select name="status" class="border rounded px-2 py-1 text-xs">
                                            <option value="Pending" <%= o.status==='Pending'?'selected':'' %>>Pending</option>
                                            <option value="Processing" <%= o.status==='Processing'?'selected':'' %>>Processing</option>
                                            <option value="Completed" <%= o.status==='Completed'?'selected':'' %>>Completed</option>
                                            <option value="Cancelled" <%= o.status==='Cancelled'?'selected':'' %>>Cancelled</option>
                                        </select>
                                        <button type="submit" class="bg-rose-900 text-white px-2 py-1 rounded text-xs">Update</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</body>
</html>
