<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Store Logo & Design</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans flex min-h-screen">
    <aside class="w-64 bg-gray-900 text-white p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold mb-6">SARAE ADMIN</h2>
            <nav class="space-y-2 text-sm">
                <a href="/admin/dashboard" class="block py-2 px-3 rounded-lg hover:bg-gray-800">Dashboard</a>
                <a href="/admin/ai-agent" class="block py-2 px-3 rounded-lg hover:bg-gray-800">🤖 AI Agent</a>
                <a href="/admin/payment-settings" class="block py-2 px-3 rounded-lg hover:bg-gray-800">💳 Payment Settings</a>
                <a href="/admin/logo-design" class="block py-2 px-3 rounded-lg bg-gray-800 font-bold">🎨 Store Logo & Design</a>
                <a href="/admin/chatbot-settings" class="block py-2 px-3 rounded-lg hover:bg-gray-800">💬 Chatbot Settings</a>
            </nav>
        </div>
        <a href="/admin/logout" class="text-red-400">Logout</a>
    </aside>
    <main class="flex-1 p-8 overflow-y-auto">
        <h1 class="text-3xl font-bold mb-6">Store Logo & Theme Design</h1>
        <% if (message) { %><div class="bg-green-100 text-green-700 p-3 rounded-lg mb-4"><%= message %></div><% } %>
        <form action="/admin/logo-design" method="POST" enctype="multipart/form-data" class="bg-white p-6 rounded-xl shadow-sm max-w-xl space-y-4">
            <div>
                <label class="block text-sm font-bold mb-1">Store Logo</label>
                <% if (settings.store_logo) { %><img src="<%= settings.store_logo %>" class="h-12 mb-2"><% } %>
                <input type="file" name="store_logo" class="w-full border p-2 rounded-lg">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Theme Color (Hex)</label>
                <input type="text" name="theme_color" value="<%= settings.theme_color %>" class="w-full border p-2 rounded-lg">
            </div>
            <button type="submit" class="bg-rose-900 text-white px-6 py-2 rounded-lg font-bold">Save Design</button>
        </form>
    </main>
</body>
</html>
