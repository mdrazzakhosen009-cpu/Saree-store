<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Store & Chatbot Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary-color: <%= typeof settings !== 'undefined' && settings.theme_color ? settings.theme_color : '#800020' %>; }
        .bg-primary { background-color: var(--primary-color); }
        .text-primary { color: var(--primary-color); }
    </style>
</head>
<body class="bg-gray-100 font-sans flex">
    <aside class="w-64 bg-gray-900 text-white min-h-screen p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold mb-8 tracking-wider">SARAE ADMIN</h2>
            <nav class="space-y-3 font-medium">
                <a href="/admin/dashboard" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-home mr-3"></i> Dashboard</a>
                <a href="/admin/products" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-box mr-3"></i> Products</a>
                <a href="/admin/orders" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-shopping-cart mr-3"></i> Orders</a>
                <a href="/admin/settings" class="block py-2.5 px-4 rounded-lg bg-primary text-white"><i class="fa fa-cogs mr-3"></i> Settings & Logo</a>
                <a href="/admin/password" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-key mr-3"></i> Change Password</a>
            </nav>
        </div>
        <div>
            <a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a>
        </div>
    </aside>

    <main class="flex-1 p-8 overflow-y-auto">
        <h1 class="text-3xl font-bold mb-8">Store & Chatbot Settings</h1>
        <% if(typeof message !== 'undefined' && message) { %>
            <div class="bg-green-50 text-green-700 p-4 rounded-xl mb-6"><%= message %></div>
        <% } %>
        <form action="/admin/settings" method="POST" enctype="multipart/form-data" class="bg-white p-8 rounded-2xl shadow-sm border space-y-6 max-w-3xl">
            <div>
                <label class="block text-sm font-bold mb-1">Store Name</label>
                <input type="text" name="store_name" value="<%= settings.store_name || '' %>" required class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Store Logo</label>
                <input type="file" name="store_logo_file" class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Theme Color (Hex) - Website Design</label>
                <input type="text" name="theme_color" value="<%= settings.theme_color || '#800020' %>" required class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Delivery Time Info (Chatbot & Footer)</label>
                <input type="text" name="delivery_time" value="<%= settings.delivery_time || '' %>" required class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Store Info (What we sell)</label>
                <textarea name="store_info" rows="3" required class="w-full border rounded-lg px-3 py-2 text-sm"><%= settings.store_info || '' %></textarea>
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Chatbot Order Instructions Prompt</label>
                <textarea name="chat_order_prompt" rows="3" required class="w-full border rounded-lg px-3 py-2 text-sm"><%= settings.chat_order_prompt || '' %></textarea>
            </div>

            <!-- Payment Numbers & Type (Personal / Agent) -->
            <div class="border-t pt-6 space-y-4">
                <h3 class="text-lg font-bold text-gray-800">Payment Numbers & Types</h3>
                
                <!-- bKash -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border">
                    <div>
                        <label class="block text-sm font-bold mb-1">bKash Number</label>
                        <input type="text" name="bkash_number" value="<%= settings.bkash_number || '' %>" placeholder="01700000000" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-1">Account Type</label>
                        <select name="bkash_type" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                            <option value="Personal" <%= settings.bkash_type === 'Personal' ? 'selected' : '' %>>Personal</option>
                            <option value="Agent" <%= settings.bkash_type === 'Agent' ? 'selected' : '' %>>Agent</option>
                        </select>
                    </div>
                </div>

                <!-- Nagad -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border">
                    <div>
                        <label class="block text-sm font-bold mb-1">Nagad Number</label>
                        <input type="text" name="nagad_number" value="<%= settings.nagad_number || '' %>" placeholder="01700000000" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-1">Account Type</label>
                        <select name="nagad_type" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                            <option value="Personal" <%= settings.nagad_type === 'Personal' ? 'selected' : '' %>>Personal</option>
                            <option value="Agent" <%= settings.nagad_type === 'Agent' ? 'selected' : '' %>>Agent</option>
                        </select>
                    </div>
                </div>

                <!-- Rocket -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-gray-50 p-4 rounded-xl border">
                    <div>
                        <label class="block text-sm font-bold mb-1">Rocket Number</label>
                        <input type="text" name="rocket_number" value="<%= settings.rocket_number || '' %>" placeholder="01700000000" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                    </div>
                    <div>
                        <label class="block text-sm font-bold mb-1">Account Type</label>
                        <select name="rocket_type" class="w-full border rounded-lg px-3 py-2 text-sm bg-white">
                            <option value="Personal" <%= settings.rocket_type === 'Personal' ? 'selected' : '' %>>Personal</option>
                            <option value="Agent" <%= settings.rocket_type === 'Agent' ? 'selected' : '' %>>Agent</option>
                        </select>
                    </div>
                </div>
            </div>

            <button type="submit" class="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-md">Save Settings</button>
        </form>
    </main>
</body>
</html>
