<%- include('partials/header') %>
<main class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-serif font-bold mb-8">Checkout</h1>
    <form action="/order/place" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-8 bg-white p-8 rounded-2xl shadow-sm border">
        <div class="space-y-4">
            <h2 class="text-lg font-bold border-b pb-2">Shipping Information</h2>
            <div>
                <label class="block text-sm font-bold mb-1">Full Name</label>
                <input type="text" name="customer_name" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Phone Number</label>
                <input type="text" name="phone" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Delivery Address</label>
                <textarea name="address" required rows="3" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary"></textarea>
            </div>
        </div>

        <div class="space-y-4 flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold border-b pb-2">Payment Details</h2>
                <div class="mt-4 space-y-3">
                    <label class="flex items-center space-x-3 p-3 border rounded-xl cursor-pointer">
                        <input type="radio" name="payment_method" value="bKash" checked onchange="toggleTrx(true)">
                        <span class="font-bold text-pink-600">bKash (Send Money to 01700000000)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3 border rounded-xl cursor-pointer">
                        <input type="radio" name="payment_method" value="Nagad" onchange="toggleTrx(true)">
                        <span class="font-bold text-orange-600">Nagad (Send Money to 01700000000)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3 border rounded-xl cursor-pointer">
                        <input type="radio" name="payment_method" value="Rocket" onchange="toggleTrx(true)">
                        <span class="font-bold text-purple-600">Rocket (Send Money to 01700000000)</span>
                    </label>
                    <label class="flex items-center space-x-3 p-3 border rounded-xl cursor-pointer">
                        <input type="radio" name="payment_method" value="COD" onchange="toggleTrx(false)">
                        <span class="font-bold text-gray-700">Cash on Delivery</span>
                    </label>
                </div>
                <div id="trx-box" class="mt-4">
                    <label class="block text-sm font-bold mb-1">Transaction ID (TrxID)</label>
                    <input type="text" name="trx_id" id="trx-input" placeholder="e.g. 9N87B65V4" class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-primary">
                </div>
            </div>
            <div>
                <div class="flex justify-between py-2 font-bold text-lg border-t">
                    <span>Total Amount:</span>
                    <span class="text-primary">৳<%= total %></span>
                </div>
                <button type="submit" class="w-full bg-primary text-white py-3 rounded-xl font-bold shadow-lg hover:opacity-95 mt-4">Place Order</button>
            </div>
        </div>
    </form>
</main>
<script>
function toggleTrx(show) {
    const box = document.getElementById('trx-box');
    const input = document.getElementById('trx-input');
    if(show) {
        box.style.display = 'block';
        input.required = true;
    } else {
        box.style.display = 'none';
        input.required = false;
    }
}
</script>
<%- include('partials/footer') %>
