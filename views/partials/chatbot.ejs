<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Chatbot Settings</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary-color: <%= typeof settings !== 'undefined' && settings.theme_color ? settings.theme_color : '#800020' %>; }
        .bg-primary { background-color: var(--primary-color); }
        .text-primary { color: var(--primary-color); }
    </style>
</head>
<body class="bg-gray-100 font-sans flex min-h-screen">
    <aside class="w-64 bg-gray-900 text-white p-6 flex flex-col justify-between">
        <div>
            <h2 class="text-xl font-bold mb-8 tracking-wider">SARAE ADMIN</h2>
            <nav class="space-y-3 font-medium">
                <a href="/admin/dashboard" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-home mr-3"></i> Dashboard</a>
                <a href="/admin/products" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-box mr-3"></i> Products</a>
                <a href="/admin/orders" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-shopping-cart mr-3"></i> Orders</a>
                <a href="/admin/settings" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-cogs mr-3"></i> Settings & Logo</a>
                <a href="/admin/chatbot" class="block py-2.5 px-4 rounded-lg bg-primary text-white"><i class="fa fa-robot mr-3"></i> AI Chatbot</a>
                <a href="/admin/password" class="block py-2.5 px-4 rounded-lg hover:bg-gray-800 text-gray-300"><i class="fa fa-key mr-3"></i> Change Password</a>
            </nav>
        </div>
        <div>
            <a href="/admin/logout" class="block py-2 px-4 text-red-400 hover:bg-gray-800 rounded-lg"><i class="fa fa-sign-out-alt mr-3"></i> Logout</a>
        </div>
    </aside>

    <main class="flex-1 p-8 overflow-y-auto">
        <h1 class="text-3xl font-bold mb-8">AI Chatbot Settings</h1>
        <% if(typeof message !== 'undefined' && message) { %>
            <div class="bg-green-50 text-green-700 p-4 rounded-xl mb-6"><%= message %></div>
        <% } %>
        <form action="/admin/chatbot" method="POST" class="bg-white p-8 rounded-2xl shadow-sm border space-y-6 max-w-2xl">
            <div>
                <label class="block text-sm font-bold mb-1">Chatbot Order Instructions Prompt</label>
                <textarea name="chat_order_prompt" rows="5" required class="w-full border rounded-lg px-3 py-2 text-sm"><%= settings.chat_order_prompt || '' %></textarea>
                <p class="text-xs text-gray-500 mt-1">এই প্রম্পটটি দিয়ে এআই চ্যাটবট নিয়ন্ত্রণ করা হয়, কাস্টমার অর্ডার করার সময় কীভাবে কথা বলবে বা গাইড করবে তা এখানে সেট করুন।</p>
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Delivery Time Info (Chatbot Response)</label>
                <input type="text" name="delivery_time" value="<%= settings.delivery_time || '' %>" required class="w-full border rounded-lg px-3 py-2 text-sm">
            </div>
            <button type="submit" class="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-md">Save Chatbot Settings</button>
        </form>
    </main>
</body>
</html>
    .then(res => res.json())
    .then(data => {
        let html = 'AI Match found! Check out these similar sarees:<br>';
        data.matched_products.forEach(p => {
            html += `<div class="mt-2 flex items-center space-x-2"><img src="${p.image}" class="w-10 h-10 object-cover rounded"><span>${p.name} - ৳${p.price}</span></div>`;
        });
        appendMsg('bot', html);
    }).catch(err => {
        appendMsg('bot', 'Could not match image at this moment. Please browse our catalog.');
    });
}
</script>
