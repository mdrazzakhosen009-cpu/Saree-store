<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= settings.store_name || 'Royal Silk & Saree' %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root { --primary-color: <%= settings.theme_color || '#800020' %>; }
        .bg-primary { background-color: var(--primary-color); }
        .text-primary { color: var(--primary-color); }
        .border-primary { border-color: var(--primary-color); }
    </style>
</head>
<body class="bg-gray-50 text-gray-800 font-sans antialiased">
    <!-- Top Bar -->
    <div class="bg-gray-900 text-white text-xs py-2 px-4 flex justify-between items-center">
        <div><i class="fa fa-phone mr-1"></i> +880 1700-000000 | <i class="fa fa-envelope mr-1"></i> support@sareestore.com</div>
        <div class="space-x-4">
            <a href="/track" class="hover:underline">Track Order</a>
            <a href="/admin/login" class="hover:underline">Admin Panel</a>
        </div>
    </div>
    <!-- Main Header -->
    <header class="sticky top-0 z-50 bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
            <a href="/" class="flex items-center space-x-2">
                <img src="<%= settings.store_logo || '/uploads/default-logo.png' %>" alt="Logo" class="h-10 w-10 object-cover rounded-full border border-primary">
                <span class="text-xl font-bold text-primary tracking-wide"><%= settings.store_name %></span>
            </a>
            <nav class="hidden md:flex space-x-6 font-medium">
                <a href="/" class="hover:text-primary">Home</a>
                <a href="/shop" class="hover:text-primary">Catalog</a>
                <a href="/shop?category=Jamdani" class="hover:text-primary">Jamdani</a>
                <a href="/shop?category=Katan" class="hover:text-primary">Katan</a>
                <a href="/track" class="hover:text-primary">Order Tracking</a>
            </nav>
            <div class="flex items-center space-x-4">
                <a href="/cart" class="relative text-gray-700 hover:text-primary">
                    <i class="fa fa-shopping-bag text-xl"></i>
                    <% if(cartCount > 0) { %>
                        <span class="absolute -top-2 -right-2 bg-primary text-white text-xs rounded-full h-5 w-5 flex items-center justify-center"><%= cartCount %></span>
                    <% } %>
                </a>
            </div>
        </div>
    </header>
