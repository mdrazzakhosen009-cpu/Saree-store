<%- include('partials/header') %>
<main class="max-w-2xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-serif font-bold mb-8 text-center">Order Tracking</h1>
    <form action="/track" method="GET" class="flex space-x-2 mb-8">
        <input type="text" name="order_id" placeholder="Enter Order ID (e.g. SAR-123456)" required class="flex-1 border rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-primary shadow-sm">
        <button type="submit" class="bg-primary text-white px-6 py-3 rounded-xl font-bold shadow-md">Track</button>
    </form>

    <% if(success && order) { %>
        <div class="bg-green-50 border border-green-200 text-green-800 p-4 rounded-xl mb-6 text-center">
            Order placed successfully! Keep your Order ID safe.
        </div>
    <% } %>

    <% if(order) { %>
        <div class="bg-white p-6 rounded-2xl shadow-sm border space-y-4">
            <div class="flex justify-between items-center border-b pb-4">
                <span class="font-bold text-lg text-primary"><%= order.order_id %></span>
                <span class="px-3 py-1 bg-yellow-100 text-yellow-800 rounded-full text-xs font-bold uppercase"><%= order.status %></span>
            </div>
            <div class="grid grid-cols-2 gap-4 text-sm">
                <div><strong>Customer:</strong> <%= order.customer_name %></div>
                <div><strong>Phone:</strong> <%= order.phone %></div>
                <div class="col-span-2"><strong>Address:</strong> <%= order.address %></div>
                <div><strong>Payment:</strong> <%= order.payment_method %></div>
                <div><strong>Total:</strong> ৳<%= order.total %></div>
            </div>
        </div>
    <% } else if(success === false && order === null && order_id) { %>
        <p class="text-center text-gray-500">No order found with that ID.</p>
    <% } %>
</main>
<%- include('partials/footer') %>
