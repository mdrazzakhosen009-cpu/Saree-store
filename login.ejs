<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Saree Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center h-screen">
    <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md border border-gray-100">
        <h1 class="text-2xl font-serif font-bold mb-6 text-center text-gray-900">Admin Login</h1>
        <% if(error) { %>
            <div class="bg-red-50 text-red-700 p-3 rounded-lg mb-4 text-sm"><%= error %></div>
        <% } %>
        <form action="/admin/login" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-bold mb-1">Username</label>
                <input type="text" name="username" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-800">
            </div>
            <div>
                <label class="block text-sm font-bold mb-1">Password</label>
                <input type="password" name="password" required class="w-full border rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-800">
            </div>
            <button type="submit" class="w-full bg-rose-900 text-white py-3 rounded-xl font-bold shadow-md hover:opacity-95">Login</button>
        </form>
    </div>
</body>
</html>
