<%- include('partials/header') %>
<main class="max-w-7xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
        <div>
            <img src="<%= product.image %>" alt="<%= product.name %>" class="w-full h-[450px] object-cover rounded-xl shadow-md">
        </div>
        <div class="flex flex-col justify-between">
            <div>
                <span class="text-xs text-primary font-bold uppercase tracking-wider bg-red-50 px-3 py-1 rounded-full"><%= product.category %></span>
                <h1 class="text-3xl font-serif font-bold mt-3 text-gray-900"><%= product.name %></h1>
                <div class="mt-3 flex items-center space-x-4">
                    <span class="text-2xl font-bold text-primary">৳<%= product.price %></span>
                    <% if(product.old_price > product.price) { %>
                        <span class="text-sm text-gray-400 line-through">৳<%= product.old_price %></span>
                    <% } %>
                </div>
                <p class="text-gray-600 mt-6 leading-relaxed"><%= product.description %></p>
            </div>
            <form action="/cart/add" method="POST" class="mt-8">
                <input type="hidden" name="id" value="<%= product.id %>">
                <input type="hidden" name="name" value="<%= product.name %>">
                <input type="hidden" name="price" value="<%= product.price %>">
                <input type="hidden" name="image" value="<%= product.image %>">
                <button type="submit" class="w-full bg-primary text-white py-3 rounded-xl font-bold shadow-lg hover:opacity-95 transition"><i class="fa fa-shopping-bag mr-2"></i> Add to Cart</button>
            </form>
        </div>
    </div>
</main>
<%- include('partials/footer') %>
